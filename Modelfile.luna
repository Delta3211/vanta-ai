Now let's write `style.css` with a complete, production-grade glassmorphism design system:

```tool
{"tool": "write_file", "args": {"path": "style.css", "content": ":root {\n  --bg-dark: #070913;\n  --card-bg: rgba(18, 22, 43, 0.65);\n  --card-border: rgba(255, 255, 255, 0.08);\n  --primary: #6366F1;\n  --primary-hover: #4F46E5;\n  --primary-glow: rgba(99, 102, 241, 0.45);\n  --accent: #A855F7;\n  --accent-glow: rgba(168, 85, 247, 0.35);\n  --success: #10B981;\n  --text-main: #F8FAFC;\n  --text-muted: #94A3B8;\n  --text-dim: #64748B;\n  --radius-lg: 24px;\n  --radius-md: 16px;\n  --radius-pill: 999px;\n  --font-heading: 'Space Grotesk', sans-serif;\n  --font-body: 'Inter', sans-serif;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\n\nbody {\n  background-color: var(--bg-dark);\n  color: var(--text-main);\n  font-family: var(--font-body);\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 2rem 1.5rem;\n  position: relative;\n  overflow-x: hidden;\n}\n\n.ambient-glow {\n  position: fixed;\n  border-radius: 50%;\n  pointer-events: none;\n  z-index: 0;\n  filter: blur(100px);\n}\n.glow-1 {\n  width: 450px; height: 450px;\n  background: var(--primary-glow);\n  top: -100px; left: -100px;\n}\n.glow-2 {\n  width: 500px; height: 500px;\n  background: var(--accent-glow);\n  bottom: -120px; right: -120px;\n}\n\n.app-container {\n  width: 100%;\n  max-width: 1100px;\n  position: relative;\n  z-index: 1;\n}\n\n.app-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 2rem;\n}\n\n.brand {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n}\n.brand-icon {\n  width: 48px; height: 48px;\n  border-radius: var(--radius-md);\n  background: linear-gradient(135deg, var(--primary), var(--accent));\n  display: flex; align-items: center; justify-content: center;\n  box-shadow: 0 0 25px var(--primary-glow);\n}\n.brand-icon svg {\n  width: 24px; height: 24px;\n  stroke: #ffffff;\n}\n.brand h1 {\n  font-family: var(--font-heading);\n  font-size: 1.6rem;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n}\n.subtitle {\n  color: var(--text-muted);\n  font-size: 0.85rem;\n}\n\n.status-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.5rem 1rem;\n  background: var(--card-bg);\n  border: 1px solid var(--card-border);\n  border-radius: var(--radius-pill);\n  backdrop-filter: blur(16px);\n  font-size: 0.85rem;\n  font-weight: 500;\n}\n.status-dot {\n  width: 8px; height: 8px;\n  border-radius: 50%;\n  background: var(--success);\n  box-shadow: 0 0 10px var(--success);\n}\n\n.dashboard-grid {\n  display: grid;\n  grid-template-columns: 1.15fr 1fr;\n  gap: 2rem;\n}\n@media (max-width: 860px) {\n  .dashboard-grid { grid-template-columns: 1fr; }\n}\n\n.glass-card {\n  background: var(--card-bg);\n  border: 1px solid var(--card-border);\n  border-radius: var(--radius-lg);\n  padding: 2.25rem;\n  backdrop-filter: blur(24px);\n  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.08);\n}\n\n.timer-card {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n}\n\n.pill-modes {\n  display: inline-flex;\n  padding: 0.35rem;\n  background: rgba(8, 11, 25, 0.6);\n  border: 1px solid var(--card-border);\n  border-radius: var(--radius-pill);\n  margin-bottom: 2rem;\n  gap: 0.25rem;\n}\n.mode-btn {\n  background: transparent;\n  border: none;\n  color: var(--text-muted);\n  padding: 0.5rem 1rem;\n  border-radius: var(--radius-pill);\n  font-family: var(--font-body);\n  font-size: 0.85rem;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.25s ease;\n}\n.mode-btn:hover { color: var(--text-main); }\n.mode-btn.active {\n  background: linear-gradient(135deg, var(--primary), var(--accent));\n  color: #ffffff;\n  box-shadow: 0 0 15px var(--primary-glow);\n}\n\n.timer-visual {\n  position: relative;\n  width: 280px; height: 280px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 2.25rem;\n}\n.progress-ring {\n  transform: rotate(-90deg);\n  position: absolute;\n}\n.ring-bg {\n  fill: none;\n  stroke: rgba(255, 255, 255, 0.05);\n  stroke-width: 10;\n}\n.ring-fill {\n  fill: none;\n  stroke: url(#timerGrad);\n  stroke-width: 10;\n  stroke-linecap: round;\n  stroke-dasharray: 754;\n  stroke-dashoffset: 0;\n  transition: stroke-dashoffset 0.8s ease;\n}\n\n.timer-content { z-index: 2; }\n.timer-numbers {\n  font-family: var(--font-heading);\n  font-size: 4.5rem;\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  font-variant-numeric: tabular-nums;\n  line-height: 1;\n}\n.timer-sub {\n  color: var(--text-muted);\n  font-size: 0.95rem;\n  margin-top: 0.5rem;\n}\n\n.timer-actions {\n  display: flex;\n  gap: 1rem;\n  width: 100%;\n  max-width: 320px;\n}\n.btn {\n  flex: 1;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.6rem;\n  padding: 0.85rem 1.5rem;\n  border-radius: var(--radius-pill);\n  font-family: var(--font-heading);\n  font-size: 1rem;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n  border: none;\n}\n.btn svg { width: 18px; height: 18px; }\n.btn-primary {\n  background: linear-gradient(135deg, var(--primary), var(--accent));\n  color: #ffffff;\n  box-shadow: 0 0 25px var(--primary-glow);\n}\n.btn-primary:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 0 35px var(--primary-glow);\n}\n.btn-glass {\n  background: rgba(255, 255, 255, 0.06);\n  color: var(--text-main);\n  border: 1px solid var(--card-border);\n}\n.btn-glass:hover {\n  background: rgba(255, 255, 255, 0.12);\n  transform: translateY(-2px);\n}\n\n.tasks-card {\n  display: flex;\n  flex-direction: column;\n}\n.card-header {\n  margin-bottom: 1.5rem;\n}\n.card-header h2 {\n  font-family: var(--font-heading);\n  font-size: 1.35rem;\n  font-weight: 700;\n}\n.card-sub {\n  color: var(--text-muted);\n  font-size: 0.85rem;\n  margin-top: 0.25rem;\n}\n.progress-bar-wrap {\n  height: 6px;\n  background: rgba(255, 255, 255, 0.06);\n  border-radius: var(--radius-pill);\n  margin-top: 0.85rem;\n  overflow: hidden;\n}\n.progress-bar-fill {\n  height: 100%;\n  width: 0%;\n  background: linear-gradient(90deg, var(--primary), var(--success));\n  border-radius: var(--radius-pill);\n  transition: width 0.4s ease;\n}\n\n.task-input-wrap {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  background: rgba(8, 11, 25, 0.6);\n  border: 1px solid var(--card-border);\n  border-radius: var(--radius-md);\n  padding: 0.5rem 0.5rem 0.5rem 1rem;\n  margin-bottom: 1.25rem;\n  transition: border-color 0.2s;\n}\n.task-input-wrap:focus-within {\n  border-color: var(--primary);\n  box-shadow: 0 0 20px var(--primary-glow);\n}\n.task-input-wrap input {\n  flex: 1;\n  background: transparent;\n  border: none;\n  color: var(--text-main);\n  font-family: var(--font-body);\n  font-size: 0.95rem;\n  outline: none;\n}\n.task-input-wrap input::placeholder { color: var(--text-dim); }\n.btn-add {\n  width: 36px; height: 36px;\n  border-radius: 10px;\n  background: var(--primary);\n  color: #ffffff;\n  border: none;\n  display: flex; align-items: center; justify-content: center;\n  cursor: pointer;\n  transition: transform 0.2s;\n}\n.btn-add:hover { transform: scale(1.05); }\n.btn-add svg { width: 18px; height: 18px; }\n\n.task-list {\n  list-style: none;\n  display: flex;\n  flex-direction: column;\n  gap: 0.6rem;\n  overflow-y: auto;\n  max-height: 320px;\n  padding-right: 0.25rem;\n}\n.task-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0.85rem 1rem;\n  background: rgba(255, 255, 255, 0.03);\n  border: 1px solid var(--card-border);\n  border-radius: var(--radius-md);\n  transition: all 0.2s ease;\n}\n.task-item:hover {\n  background: rgba(255, 255, 255, 0.06);\n  transform: translateX(3px);\n}\n.task-left {\n  display: flex;\n  align-items: center;\n  gap: 0.85rem;\n}\n.task-checkbox {\n  width: 20px; height: 20px;\n  border-radius: 6px;\n  border: 1.5px solid var(--text-dim);\n  background: transparent;\n  display: flex; align-items: center; justify-content: center;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n.task-item.completed .task-checkbox {\n  background: var(--success);\n  border-color: var(--success);\n}\n.task-text {\n  font-size: 0.95rem;\n  transition: all 0.2s;\n}\n.task-item.completed .task-text {\n  color: var(--text-dim);\n  text-decoration: line-through;\n}\n.btn-delete {\n  background: transparent;\n  border: none;\n  color: var(--text-dim);\n  cursor: pointer;\n  padding: 4px;\n  border-radius: 6px;\n  opacity: 0;\n  transition: all 0.2s;\n}\n.task-item:hover .btn-delete { opacity: 1; }\n.btn-delete:hover { color: #EF4444; background: rgba(239, 68, 68, 0.1); }\n.btn-delete svg { width: 16px; height: 16px; }\n"}}
```

Now let's write `script.js` with crash-proof event handling, sound synthesizer, and LocalStorage:

```tool
{"tool": "write_file", "args": {"path": "script.js", "content": "document.addEventListener('DOMContentLoaded', () => {\n  // 1. Audio alert via Web Audio API (zero external files required)\n  function playChime() {\n    try {\n      const AudioCtx = window.AudioContext || window.webkitAudioContext;\n      if (!AudioCtx) return;\n      const ctx = new AudioCtx();\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5\n      osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.25); // A5\n      gain.gain.setValueAtTime(0.25, ctx.currentTime);\n      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 1.2);\n      osc.connect(gain);\n      gain.connect(ctx.destination);\n      osc.start();\n      osc.stop(ctx.currentTime + 1.2);\n    } catch (err) {\n      console.warn('Audio not allowed without gesture', err);\n    }\n  }\n\n  // 2. Timer State\n  const modes = {\n    pomodoro:   { time: 25 * 60, label: 'Work Mode', sub: 'Stay in the zone' },\n    shortBreak: { time: 5 * 60,  label: 'Short Break', sub: 'Take a breath & stretch' },\n    longBreak:  { time: 15 * 60, label: 'Long Break', sub: 'Refuel and recharge' }\n  };\n\n  let currentMode = 'pomodoro';\n  let totalSeconds = modes.pomodoro.time;\n  let remainingSeconds = totalSeconds;\n  let timerInterval = null;\n  let isRunning = false;\n\n  const CIRCLE_RADIUS = 120;\n  const CIRCUMFERENCE = 2 * Math.PI * CIRCLE_RADIUS; // ~753.98\n\n  // DOM Elements with safe query\n  const timerDisplay   = document.getElementById('timerDisplay');\n  const progressCircle = document.getElementById('progressCircle');\n  const startBtn       = document.getElementById('startBtn');\n  const resetBtn       = document.getElementById('resetBtn');\n  const sessionLabel   = document.getElementById('sessionLabel');\n  const sessionSubtext = document.getElementById('sessionSubtext');\n  const modeBtns       = document.querySelectorAll('.mode-btn');\n\n  if (progressCircle) {\n    progressCircle.style.strokeDasharray = CIRCUMFERENCE;\n    progressCircle.style.strokeDashoffset = 0;\n  }\n\n  function formatTime(secs) {\n    const m = Math.floor(secs / 60).toString().padStart(2, '0');\n    const s = (secs % 60).toString().padStart(2, '0');\n    return `${m}:${s}`;\n  }\n\n  function updateUI() {\n    if (timerDisplay) timerDisplay.textContent = formatTime(remainingSeconds);\n    document.title = `${formatTime(remainingSeconds)} — FocusFlow`;\n    if (progressCircle) {\n      const progress = 1 - (remainingSeconds / totalSeconds);\n      const offset = CIRCUMFERENCE * progress;\n      progressCircle.style.strokeDashoffset = offset;\n    }\n  }\n\n  function switchMode(newMode) {\n    clearInterval(timerInterval);\n    isRunning = false;\n    currentMode = newMode;\n    totalSeconds = modes[newMode].time;\n    remainingSeconds = totalSeconds;\n    if (startBtn) startBtn.querySelector('span').textContent = 'Start Focus';\n    if (sessionLabel) sessionLabel.textContent = modes[newMode].label;\n    if (sessionSubtext) sessionSubtext.textContent = modes[newMode].sub;\n    modeBtns.forEach(b => b.classList.toggle('active', b.dataset.mode === newMode));\n    updateUI();\n  }\n\n  modeBtns.forEach(btn => {\n    btn.addEventListener('click', () => switchMode(btn.dataset.mode));\n  });\n\n  if (startBtn) {\n    startBtn.addEventListener('click', () => {\n      if (isRunning) {\n        clearInterval(timerInterval);\n        isRunning = false;\n        startBtn.querySelector('span').textContent = 'Resume';\n      } else {\n        isRunning = true;\n        startBtn.querySelector('span').textContent = 'Pause';\n        timerInterval = setInterval(() => {\n          if (remainingSeconds > 0) {\n            remainingSeconds--;\n            updateUI();\n          } else {\n            clearInterval(timerInterval);\n            isRunning = false;\n            playChime();\n            alert(`${modes[currentMode].label} completed!`);\n            switchMode(currentMode === 'pomodoro' ? 'shortBreak' : 'pomodoro');\n          }\n        }, 1000);\n      }\n    });\n  }\n\n  if (resetBtn) {\n    resetBtn.addEventListener('click', () => switchMode(currentMode));\n  }\n\n  // 3. Task Management with LocalStorage\n  const taskForm        = document.getElementById('taskForm');\n  const taskInput       = document.getElementById('taskInput');\n  const taskList        = document.getElementById('taskList');\n  const taskStats       = document.getElementById('taskStats');\n  const taskProgressBar = document.getElementById('taskProgressBar');\n\n  let tasks = JSON.parse(localStorage.getItem('focusflow_tasks') || '[]');\n  if (!Array.isArray(tasks) || tasks.length === 0) {\n    tasks = [\n      { id: '1', text: 'Structure components & layout', completed: true },\n      { id: '2', text: 'Implement glassmorphism styles', completed: true },\n      { id: '3', text: 'Complete deep focus session', completed: false }\n    ];\n  }\n\n  function saveTasks() {\n    localStorage.setItem('focusflow_tasks', JSON.stringify(tasks));\n    renderTasks();\n  }\n\n  function renderTasks() {\n    if (!taskList) return;\n    taskList.innerHTML = '';\n    const completedCount = tasks.filter(t => t.completed).length;\n\n    if (taskStats) taskStats.textContent = `${completedCount} of ${tasks.length} tasks completed`;\n    if (taskProgressBar) {\n      const pct = tasks.length > 0 ? (completedCount / tasks.length) * 100 : 0;\n      taskProgressBar.style.width = `${pct}%`;\n    }\n\n    tasks.forEach(task => {\n      const li = document.createElement('li');\n      li.className = `task-item ${task.completed ? 'completed' : ''}`;\n      li.innerHTML = `\n        <div class=\"task-left\">\n          <button class=\"task-checkbox\" aria-label=\"Toggle task\">\n            ${task.completed ? '<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"3\"><polyline points=\"20 6 9 17 4 12\"/></svg>' : ''}\n          </button>\n          <span class=\"task-text\">${escapeHtml(task.text)}</span>\n        </div>\n        <button class=\"btn-delete\" aria-label=\"Delete task\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"/><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"/></svg>\n        </button>\n      `;\n\n      li.querySelector('.task-checkbox').addEventListener('click', () => {\n        task.completed = !task.completed;\n        saveTasks();\n      });\n\n      li.querySelector('.btn-delete').addEventListener('click', () => {\n        tasks = tasks.filter(t => t.id !== task.id);\n        saveTasks();\n      });\n\n      taskList.appendChild(li);\n    });\n  }\n\n  function escapeHtml(str) {\n    const div = document.createElement('div');\n    div.textContent = str;\n    return div.innerHTML;\n  }\n\n  if (taskForm && taskInput) {\n    taskForm.addEventListener('submit', (e) => {\n      e.preventDefault();\n      const val = taskInput.value.trim();\n      if (!val) return;\n      tasks.push({ id: Date.now().toString(), text: val, completed: false });\n      taskInput.value = '';\n      saveTasks();\n    });\n  }\n\n  updateUI();\n  renderTasks();\n});\n"}}
```

