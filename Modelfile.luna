MESSAGE user "Explain all the React hooks I should know with examples"
MESSAGE assistant """Every React hook you actually need:

```tsx
import {
  useState, useEffect, useRef, useMemo, useCallback,
  useContext, useReducer, useId, useTransition,
  useDeferredValue, useLayoutEffect
} from 'react';

// ── useState ──────────────────────────────────────
const [count, setCount] = useState(0);

// Functional update — always use when new state depends on old state
setCount(prev => prev + 1); // ✅ safe
setCount(count + 1);         // ❌ stale closure risk in closures

// Object state — must spread, setState is not a merge
const [user, setUser] = useState({ name: '', email: '' });
setUser(prev => ({ ...prev, name: 'Alice' })); // ✅
setUser({ name: 'Alice' });                      // ❌ loses email

// ── useEffect ─────────────────────────────────────
useEffect(() => {
  // Runs after render, like componentDidMount + componentDidUpdate
  const controller = new AbortController();

  fetch('/api/data', { signal: controller.signal })
    .then(r => r.json())
    .then(setData)
    .catch(e => { if (e.name !== 'AbortError') setError(e); });

  return () => controller.abort(); // cleanup — like componentWillUnmount
}, [/* deps */]); // re-runs when any dep changes

// ── useRef ────────────────────────────────────────
// 1. DOM reference
const inputRef = useRef<HTMLInputElement>(null);
<input ref={inputRef} />
inputRef.current?.focus();

// 2. Mutable value that doesn't trigger re-render
const timerRef = useRef<ReturnType<typeof setInterval> | null>(null);
timerRef.current = setInterval(() => {}, 1000);
clearInterval(timerRef.current!);

// 3. Previous value pattern
function usePrevious<T>(value: T) {
  const ref = useRef<T>(value);
  useEffect(() => { ref.current = value; });
  return ref.current;
}

// ── useMemo ───────────────────────────────────────
// Memoises an expensive computed value
const sortedItems = useMemo(
  () => items.slice().sort((a, b) => a.name.localeCompare(b.name)),
  [items] // recompute only when items changes
);

// ── useCallback ───────────────────────────────────
// Memoises a function reference (stable across renders)
const handleSubmit = useCallback(async (data: FormData) => {
  await saveUser(data);
  onSuccess?.();
}, [onSuccess]); // new function only when onSuccess changes

// ── useReducer ────────────────────────────────────
// Better than useState for complex state logic
type State = { count: number; error: string | null; loading: boolean };
type Action =
  | { type: 'increment' }
  | { type: 'set_error'; payload: string }
  | { type: 'set_loading'; payload: boolean };

function reducer(state: State, action: Action): State {
  switch (action.type) {
    case 'increment':    return { ...state, count: state.count + 1 };
    case 'set_error':    return { ...state, error: action.payload };
    case 'set_loading':  return { ...state, loading: action.payload };
  }
}

const [state, dispatch] = useReducer(reducer, { count: 0, error: null, loading: false });
dispatch({ type: 'increment' });

// ── useContext ────────────────────────────────────
const ThemeContext = createContext<'light' | 'dark'>('light');

function useTheme() {
  const theme = useContext(ThemeContext);
  if (theme === undefined) throw new Error('useTheme must be inside ThemeProvider');
  return theme;
}

// ── useId ─────────────────────────────────────────
// Generate stable unique IDs (SSR-safe)
function FormField({ label }: { label: string }) {
  const id = useId();
  return (
    <div>
      <label htmlFor={id}>{label}</label>
      <input id={id} />
    </div>
  );
}

// ── useTransition ─────────────────────────────────
// Mark state updates as non-urgent (keep UI responsive)
const [isPending, startTransition] = useTransition();

function handleSearch(query: string) {
  setSearchQuery(query); // urgent — update input immediately
  startTransition(() => {
    setResults(search(query)); // non-urgent — can be deferred
  });
}

// ── useDeferredValue ──────────────────────────────
// Defer an expensive render
const deferredQuery = useDeferredValue(searchQuery);
const results = useMemo(() => search(deferredQuery), [deferredQuery]);

// ── useLayoutEffect ───────────────────────────────
// Like useEffect but fires synchronously before paint
// Use for: measuring DOM, synchronising with animations
const [height, setHeight] = useState(0);
const ref = useRef<HTMLDivElement>(null);
useLayoutEffect(() => {
  setHeight(ref.current?.offsetHeight ?? 0);
}, []);
```

**Decision tree:**
- Storing UI state → `useState`
- Complex state logic with multiple sub-values → `useReducer`
- Side effects (fetch, subscriptions, timers) → `useEffect`
- DOM reference or mutable value → `useRef`
- Expensive computation → `useMemo`
- Stable function reference → `useCallback`
- Shared state across tree → `useContext`
- Accessible form IDs → `useId`
- Keep UI responsive during heavy updates → `useTransition`
"""

MESSAGE user "What are React Server Components? When should I use them vs Client Components?"
MESSAGE assistant """Server Components run on the server and never ship JavaScript to the browser. They're the default in Next.js 14+ App Router.

```tsx
// ── Server Component (default in App Router) ──────
// app/users/page.tsx
// No 'use client' — runs on server only

import { db } from '@/lib/db';

// This component can be async — runs on the server
export default async function UsersPage() {
  // Direct DB access — no API route needed
  const users = await db.user.findMany({
    select: { id: true, name: true, email: true },
    orderBy: { createdAt: 'desc' },
  });

  return (
    <main>
      <h1>Users</h1>
      <ul>
        {users.map(user => (
          <li key={user.id}>
            {user.name} — {user.email}
          </li>
        ))}
      </ul>
    </main>
  );
}
// Zero JavaScript sent to browser for this component
// Data fetched at request time, no client-side loading state needed

// ── Client Component ──────────────────────────────
// 'use client' marks this boundary
'use client';

import { useState } from 'react';

export function SearchBar({ onSearch }: { onSearch: (q: string) => void }) {
  const [query, setQuery] = useState('');

  return (
    <input
      value={query}
      onChange={e => {
        setQuery(e.target.value);
        onSearch(e.target.value);
      }}
      placeholder="Search..."
    />
  );
}

// ── Composing them together ───────────────────────
// app/products/page.tsx (Server Component)
import { SearchBar } from './SearchBar'; // Client Component
import { ProductList } from './ProductList'; // Server Component

export default async function ProductsPage({
  searchParams,
}: {
  searchParams: { q?: string };
}) {
  const products = await fetchProducts(searchParams.q);

  return (
    <div>
      {/* Client component — has interactivity */}
      <SearchBar onSearch={/* handled via URL params */} />
      {/* Server component — renders on server */}
      <ProductList products={products} />
    </div>
  );
}

// ── Passing Server data to Client Components ──────
// Server Component fetches, Client Component renders interactively
// app/cart/page.tsx
export default async function CartPage() {
  const cart = await getCart(); // server-side fetch

  return <CartClient initialCart={cart} />; // pass as prop to client component
}

// CartClient.tsx
'use client';
export function CartClient({ initialCart }: { initialCart: Cart }) {
  const [cart, setCart] = useState(initialCart); // initialise from server data
  // ... interactive cart logic
}
```

**Decision guide:**

| Need | Use |
|---|---|
| `useState`, `useEffect`, event handlers | Client Component |
| Direct DB access, no interactivity | Server Component |
| Heavy library (chart, editor) | Client Component |
| SEO-critical content | Server Component |
| Real-time updates | Client Component |
| Secrets / API keys in component | Server Component |

**Key rule:** push `'use client'` as far down the tree as possible. A large Server Component with a small interactive island is better than a large Client Component.
"""

