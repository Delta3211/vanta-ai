MESSAGE user "Teach me TypeScript generics with real web dev examples"
MESSAGE assistant """Generics let you write reusable code that works with multiple types while keeping type safety.

```ts
// ── Basic generic function ────────────────────────
function first<T>(arr: T[]): T | undefined {
  return arr[0];
}

first([1, 2, 3]);        // type: number | undefined
first(['a', 'b', 'c']); // type: string | undefined

// ── Generic API response wrapper ──────────────────
type ApiResponse<T> =
  | { status: 'success'; data: T }
  | { status: 'error';   error: string };

async function apiFetch<T>(url: string): Promise<ApiResponse<T>> {
  const res = await fetch(url);
  if (!res.ok) return { status: 'error', error: `HTTP ${res.status}` };
  const data: T = await res.json();
  return { status: 'success', data };
}

// Usage — T is inferred from the type annotation
const result = await apiFetch<User>('/api/users/1');
if (result.status === 'success') {
  console.log(result.data.name); // TypeScript knows data is User
}

// ── Generic React component ───────────────────────
type SelectProps<T> = {
  options: T[];
  value: T;
  onChange: (value: T) => void;
  getLabel: (option: T) => string;
  getValue: (option: T) => string;
};

function Select<T>({ options, value, onChange, getLabel, getValue }: SelectProps<T>) {
  return (
    <select
      value={getValue(value)}
      onChange={e => {
        const selected = options.find(o => getValue(o) === e.target.value);
        if (selected !== undefined) onChange(selected);
      }}
    >
      {options.map(option => (
        <option key={getValue(option)} value={getValue(option)}>
          {getLabel(option)}
        </option>
      ))}
    </select>
  );
}

// Works with any type
<Select<User>
  options={users}
  value={selectedUser}
  onChange={setSelectedUser}
  getLabel={u => u.name}
  getValue={u => u.id}
/>

// ── Generic hooks ─────────────────────────────────
function useLocalStorage<T>(key: string, initial: T) {
  const [value, setValue] = useState<T>(() => {
    try {
      const item = window.localStorage.getItem(key);
      return item ? (JSON.parse(item) as T) : initial;
    } catch {
      return initial;
    }
  });

  const setStored = useCallback((val: T | ((prev: T) => T)) => {
    setValue(prev => {
      const next = typeof val === 'function' ? (val as (prev: T) => T)(prev) : val;
      localStorage.setItem(key, JSON.stringify(next));
      return next;
    });
  }, [key]);

  return [value, setStored] as const; // const assertion preserves tuple type
}

// ── Generic constraints ───────────────────────────
// T must have an id property
function findById<T extends { id: string }>(items: T[], id: string): T | undefined {
  return items.find(item => item.id === id);
}

// ── Conditional types ─────────────────────────────
// Unwrap a Promise type
type Awaited<T> = T extends Promise<infer U> ? Awaited<U> : T;
type UserResult = Awaited<ReturnType<typeof fetchUser>>; // → User

// ── Utility types in practice ─────────────────────
type User = {
  id: string;
  name: string;
  email: string;
  passwordHash: string;
  role: 'admin' | 'user';
  createdAt: Date;
};

// Public user — omit sensitive fields
type PublicUser = Omit<User, 'passwordHash'>;

// Create user input — only required fields, no auto-generated ones
type CreateUserInput = Pick<User, 'name' | 'email'> & { password: string };

// Update user — all fields optional except id
type UpdateUserInput = { id: string } & Partial<Omit<User, 'id' | 'passwordHash' | 'createdAt'>>;
```
"""

