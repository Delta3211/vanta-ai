#  TESTING
# ══════════════════════════════════════════════

MESSAGE user "How do I write good React component tests with React Testing Library?"
MESSAGE assistant """```tsx
// ── Component being tested ────────────────────────
// LoginForm.tsx
'use client';
import { useState } from 'react';

export function LoginForm({ onSuccess }: { onSuccess: (email: string) => void }) {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);

  async function handleSubmit(e: React.FormEvent) {
    e.preventDefault();
    setLoading(true);
    setError('');

    try {
      await signIn(email, password);
      onSuccess(email);
    } catch {
      setError('Invalid email or password');
    } finally {
      setLoading(false);
    }
  }

  return (
    <form onSubmit={handleSubmit}>
      <label htmlFor="email">Email</label>
      <input
        id="email"
        type="email"
        value={email}
        onChange={e => setEmail(e.target.value)}
        aria-invalid={!!error}
      />
      <label htmlFor="password">Password</label>
      <input
        id="password"
        type="password"
        value={password}
        onChange={e => setPassword(e.target.value)}
      />
      {error && <p role="alert">{error}</p>}
      <button type="submit" disabled={loading}>
        {loading ? 'Signing in…' : 'Sign in'}
      </button>
    </form>
  );
}

// ── Tests ─────────────────────────────────────────
// LoginForm.test.tsx
import { render, screen, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { LoginForm } from './LoginForm';
import { signIn } from '@/lib/auth';

// Mock the signIn function
vi.mock('@/lib/auth', () => ({
  signIn: vi.fn(),
}));

const mockSignIn = vi.mocked(signIn);

// Helper — renders with userEvent setup
function setup() {
  const onSuccess = vi.fn();
  const user = userEvent.setup();
  const utils = render(<LoginForm onSuccess={onSuccess} />);
  return { user, onSuccess, ...utils };
}

describe('LoginForm', () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it('renders email, password inputs and submit button', () => {
    setup();

    // ✅ Query by accessible role/label — not by class or test id
    expect(screen.getByLabelText('Email')).toBeInTheDocument();
    expect(screen.getByLabelText('Password')).toBeInTheDocument();
    expect(screen.getByRole('button', { name: 'Sign in' })).toBeInTheDocument();
  });

  it('calls signIn with entered credentials on submit', async () => {
    mockSignIn.mockResolvedValueOnce(undefined);
    const { user, onSuccess } = setup();

    await user.type(screen.getByLabelText('Email'), 'alice@example.com');
    await user.type(screen.getByLabelText('Password'), 'password123');
    await user.click(screen.getByRole('button', { name: 'Sign in' }));

    expect(mockSignIn).toHaveBeenCalledWith('alice@example.com', 'password123');
    await waitFor(() => expect(onSuccess).toHaveBeenCalledWith('alice@example.com'));
  });

  it('shows error message when signIn fails', async () => {
    mockSignIn.mockRejectedValueOnce(new Error('Invalid credentials'));
    const { user } = setup();

    await user.type(screen.getByLabelText('Email'), 'alice@example.com');
    await user.type(screen.getByLabelText('Password'), 'wrong');
    await user.click(screen.getByRole('button', { name: 'Sign in' }));

    // ✅ Wait for async state update
    expect(await screen.findByRole('alert')).toHaveTextContent('Invalid email or password');
  });

  it('disables button while submitting', async () => {
    // Delay resolution so we can check loading state
    mockSignIn.mockImplementation(() => new Promise(resolve => setTimeout(resolve, 100)));
    const { user } = setup();

    await user.type(screen.getByLabelText('Email'), 'alice@example.com');
    await user.type(screen.getByLabelText('Password'), 'password123');
    await user.click(screen.getByRole('button', { name: 'Sign in' }));

    expect(screen.getByRole('button', { name: 'Signing in…' })).toBeDisabled();
    await waitFor(() => expect(screen.getByRole('button', { name: 'Sign in' })).toBeEnabled());
  });
});
```

**Core principles:**
- Query by what the user sees: `getByRole`, `getByLabelText`, `getByText` — not `getByTestId` or CSS classes
- Use `userEvent` (not `fireEvent`) — it simulates real browser events including focus, keyboard
- `findBy*` = async, waits for element; `getBy*` = sync, throws if not found; `queryBy*` = sync, returns null
- Mock at the module boundary, not implementation detail
- Test behaviour, not implementation — what the user sees and does
"""

