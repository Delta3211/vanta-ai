MESSAGE user "Explain closures in JavaScript with practical examples"
MESSAGE assistant """A closure is a function that retains access to its outer scope's variables even after the outer function has returned.

```js
// ── Basic closure ───────────────────────────────
function makeCounter(initial = 0) {
  let count = initial; // captured in closure

  return {
    increment() { count += 1; },
    decrement() { count -= 1; },
    value()     { return count; },
  };
}

const counter = makeCounter(10);
counter.increment(); // 11
counter.increment(); // 12
counter.decrement(); // 11
counter.value();     // 11

// count is private — can't be accessed directly
console.log(counter.count); // undefined

// ── Practical: event handlers ───────────────────
function attachClickCounter(button) {
  let clicks = 0; // private to this call

  button.addEventListener('click', () => {
    clicks += 1;
    console.log(`Clicked ${clicks} times`);
  });
}

// Each button gets its own independent counter
attachClickCounter(document.getElementById('btn-a'));
attachClickCounter(document.getElementById('btn-b'));

// ── Practical: memoisation ──────────────────────
function memoize(fn) {
  const cache = new Map();

  return function(...args) {
    const key = JSON.stringify(args);
    if (cache.has(key)) return cache.get(key);
    const result = fn.apply(this, args);
    cache.set(key, result);
    return result;
  };
}

const expensiveCalc = memoize((n) => {
  // expensive computation
  return n * n;
});

expensiveCalc(5); // computed
expensiveCalc(5); // returned from cache

// ── Classic closure bug — var in loops ──────────
// ❌ Bug: all handlers log 3 because var is function-scoped
for (var i = 0; i < 3; i++) {
  setTimeout(() => console.log(i), 100); // logs 3, 3, 3
}

// ✅ Fix 1: use let (block-scoped, new binding per iteration)
for (let i = 0; i < 3; i++) {
  setTimeout(() => console.log(i), 100); // logs 0, 1, 2
}

// ✅ Fix 2: IIFE to create a new scope (pre-ES6 pattern)
for (var i = 0; i < 3; i++) {
  (function(j) {
    setTimeout(() => console.log(j), 100);
  })(i);
}

// ── Partial application with closures ───────────
function multiply(a) {
  return (b) => a * b; // b closes over a
}

const double = multiply(2);
const triple = multiply(3);

double(5); // 10
triple(5); // 15
```

**Mental model:** every function in JavaScript "closes over" its surrounding scope at the point it was defined — not called. The variables aren't copied, the function holds a live reference to them.

**When closures bite you:**
- `var` in loops (use `let`)
- Accidentally keeping large objects in memory (module-level closures)
- Stale closures in React `useEffect` (see: dependency arrays)
"""

MESSAGE user "How does async/await work and what are the common mistakes?"
MESSAGE assistant """async/await is syntax sugar over Promises. Here's everything you need to know:

```js
// ── Basic async/await ────────────────────────────
async function fetchUser(id) {
  const res = await fetch(`/api/users/${id}`);

  if (!res.ok) {
    throw new Error(`HTTP ${res.status}: ${res.statusText}`);
  }

  return res.json(); // returns a Promise — await unwraps it
}

// ── Error handling ────────────────────────────────
async function loadUserData(id) {
  try {
    const user = await fetchUser(id);
    const posts = await fetchPosts(user.id);
    return { user, posts };
  } catch (err) {
    console.error('Failed to load user data:', err);
    throw err; // re-throw so callers can handle it
  } finally {
    setLoading(false); // always runs
  }
}

// ── MISTAKE 1: sequential awaits that could be parallel ──
// ❌ Slow: fetchA takes 1s, fetchB takes 1s = 2s total
async function slow() {
  const a = await fetchA(); // waits for A
  const b = await fetchB(); // then waits for B
  return [a, b];
}

// ✅ Fast: both run in parallel = 1s total
async function fast() {
  const [a, b] = await Promise.all([fetchA(), fetchB()]);
  return [a, b];
}

// ── MISTAKE 2: not handling rejection in Promise.all ──
// ❌ If any promise rejects, the whole thing rejects
const results = await Promise.all([fetch1(), fetch2(), fetch3()]);

// ✅ Use allSettled when you want all results regardless
const results = await Promise.allSettled([fetch1(), fetch2(), fetch3()]);
results.forEach(result => {
  if (result.status === 'fulfilled') console.log(result.value);
  if (result.status === 'rejected')  console.error(result.reason);
});

// ── MISTAKE 3: async in forEach (doesn't wait) ──
// ❌ forEach ignores returned Promises — doesn't wait
items.forEach(async (item) => {
  await processItem(item); // not actually waited for
});

// ✅ Use for...of for sequential
for (const item of items) {
  await processItem(item);
}

// ✅ Use Promise.all for parallel
await Promise.all(items.map(item => processItem(item)));

// ── MISTAKE 4: forgetting await ──
// ❌ saveUser returns a Promise — comparing to null always false
if (saveUser(data) === null) { ... }

// ✅
if (await saveUser(data) === null) { ... }

// ── MISTAKE 5: no AbortController for cancellable requests ──
// ❌ Fetch continues even after component unmounts
useEffect(() => {
  fetch('/api/data').then(setData);
}, []);

// ✅ Cancel on cleanup
useEffect(() => {
  const controller = new AbortController();

  fetch('/api/data', { signal: controller.signal })
    .then(res => res.json())
    .then(setData)
    .catch(err => {
      if (err.name !== 'AbortError') throw err;
    });

  return () => controller.abort();
}, []);

// ── Promise combinators reference ───────────────
// Promise.all         — all resolve, or first rejection fails all
// Promise.allSettled  — wait for all, get fulfilled/rejected for each
// Promise.race        — first to resolve OR reject wins
// Promise.any         — first to resolve wins, fails only if ALL reject
```
"""

MESSAGE user "Explain event delegation and why it matters for performance"
MESSAGE assistant """Event delegation uses a single listener on a parent element instead of individual listeners on each child.

```html
<ul id="todo-list">
  <li data-id="1">
    <span>Buy groceries</span>
    <button data-action="complete">Done</button>
    <button data-action="delete">✕</button>
  </li>
  <li data-id="2">
    <span>Walk dog</span>
    <button data-action="complete">Done</button>
    <button data-action="delete">✕</button>
  </li>
  <!-- Hundreds more items... -->
</ul>
```

```js
// ❌ Without delegation — 200 listeners for 100 items
document.querySelectorAll('.todo-list button').forEach(btn => {
  btn.addEventListener('click', handleClick); // × 200
});

// ✅ With delegation — 1 listener handles everything
const list = document.getElementById('todo-list');

list.addEventListener('click', (e) => {
  const button = e.target.closest('button[data-action]');
  if (!button) return; // click was not on a button

  const action = button.dataset.action;
  const item = button.closest('li[data-id]');
  const id = item?.dataset.id;

  if (action === 'complete') markComplete(id);
  if (action === 'delete')   deleteItem(id);
});

// ── Why .closest() instead of direct e.target check ──
// If the button contains a child element (icon, span),
// clicking the child makes e.target = that child, not the button.
// .closest() walks up the DOM until it finds a match.

// ── Works for dynamically added items ────────────────
// Items added after the listener is set up still work
// because the event bubbles up to the parent.
function addTodo(text, id) {
  const li = document.createElement('li');
  li.dataset.id = id;
  li.innerHTML = `
    <span>${text}</span>
    <button data-action="complete">Done</button>
    <button data-action="delete">✕</button>
  `;
  list.appendChild(li); // listener on list catches its events automatically
}

// ── Practical custom event pattern ───────────────────
// Emit domain events up through the DOM
function markComplete(id) {
  const item = document.querySelector(`[data-id="${id}"]`);
  item?.dispatchEvent(new CustomEvent('todo:complete', {
    detail: { id },
    bubbles: true, // important — must bubble to reach parent listeners
  }));
}

document.addEventListener('todo:complete', (e) => {
  console.log('Completed todo:', e.detail.id);
});
```

**Performance impact:**
- 1000 list items → 2000 button listeners = significant memory + setup time
- 1 delegated listener = trivial
- Especially important for virtual lists, infinite scroll, or frequently re-rendered lists
"""

