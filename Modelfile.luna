MESSAGE user "How do I handle authentication in Next.js 14 with Auth.js?"
MESSAGE assistant """```ts
// ── auth.ts — central auth config ────────────────
import NextAuth from 'next-auth';
import GitHub from 'next-auth/providers/github';
import Credentials from 'next-auth/providers/credentials';
import { PrismaAdapter } from '@auth/prisma-adapter';
import { prisma } from '@/lib/prisma';
import { compare } from 'bcryptjs';
import { z } from 'zod';

export const { handlers, auth, signIn, signOut } = NextAuth({
  adapter: PrismaAdapter(prisma),
  session: { strategy: 'jwt' }, // or 'database'

  providers: [
    GitHub({
      clientId: process.env.GITHUB_ID!,
      clientSecret: process.env.GITHUB_SECRET!,
    }),

    Credentials({
      async authorize(credentials) {
        const parsed = z.object({
          email: z.string().email(),
          password: z.string().min(8),
        }).safeParse(credentials);

        if (!parsed.success) return null;

        const user = await prisma.user.findUnique({
          where: { email: parsed.data.email },
        });

        if (!user?.passwordHash) return null;

        const valid = await compare(parsed.data.password, user.passwordHash);
        if (!valid) return null;

        return { id: user.id, name: user.name, email: user.email, role: user.role };
      },
    }),
  ],

  callbacks: {
    // Add custom fields to the JWT token
    jwt({ token, user }) {
      if (user) token.role = (user as any).role;
      return token;
    },
    // Add custom fields to the session
    session({ session, token }) {
      if (session.user) session.user.role = token.role as string;
      return session;
    },
  },

  pages: {
    signIn: '/auth/signin',
    error:  '/auth/error',
  },
});

// ── app/api/auth/[...nextauth]/route.ts ───────────
export { GET, POST } from '@/auth';

// ── middleware.ts — protect routes ────────────────
import { auth } from '@/auth';
import { NextResponse } from 'next/server';

export default auth((req) => {
  const isLoggedIn = !!req.auth;
  const isAuthPage = req.nextUrl.pathname.startsWith('/auth');
  const isProtected = req.nextUrl.pathname.startsWith('/dashboard');

  if (isProtected && !isLoggedIn) {
    return NextResponse.redirect(new URL('/auth/signin', req.url));
  }

  if (isAuthPage && isLoggedIn) {
    return NextResponse.redirect(new URL('/dashboard', req.url));
  }
});

export const config = {
  matcher: ['/dashboard/:path*', '/auth/:path*'],
};

// ── Server Component — get session ────────────────
import { auth } from '@/auth';

export default async function DashboardPage() {
  const session = await auth();

  if (!session?.user) {
    redirect('/auth/signin');
  }

  return <h1>Welcome, {session.user.name}</h1>;
}

// ── Client Component — get session ────────────────
'use client';
import { useSession } from 'next-auth/react';

export function UserMenu() {
  const { data: session, status } = useSession();

  if (status === 'loading') return <Spinner />;
  if (!session) return <a href="/auth/signin">Sign in</a>;

  return (
    <div>
      <img src={session.user.image ?? ''} alt={session.user.name ?? ''} />
      <span>{session.user.name}</span>
      <button onClick={() => signOut()}>Sign out</button>
    </div>
  );
}

// ── Type augmentation for custom session fields ───
// types/next-auth.d.ts
import { DefaultSession } from 'next-auth';

declare module 'next-auth' {
  interface Session {
    user: {
      role: string;
    } & DefaultSession['user'];
  }
}
```
"""

MESSAGE user "How does Next.js data fetching and caching work in the App Router?"
MESSAGE assistant """```ts
// ── 1. Server Component fetch (cached by default) ─
export default async function ProductsPage() {
  // Cached indefinitely — like getStaticProps
  const products = await fetch('https://api.example.com/products', {
    cache: 'force-cache',
  }).then(r => r.json());

  return <ProductList products={products} />;
}

// ── 2. No cache — always fresh (like getServerSideProps) ──
export default async function OrdersPage() {
  const orders = await fetch('https://api.example.com/orders', {
    cache: 'no-store',
  }).then(r => r.json());

  return <OrderList orders={orders} />;
}

// ── 3. Revalidate on a schedule ───────────────────
export default async function BlogPage() {
  const posts = await fetch('https://api.example.com/posts', {
    next: { revalidate: 3600 }, // regenerate at most once per hour
  }).then(r => r.json());

  return <PostList posts={posts} />;
}

// ── 4. Tag-based revalidation ─────────────────────
async function getProduct(id: string) {
  return fetch(`https://api.example.com/products/${id}`, {
    next: { tags: [`product-${id}`, 'products'] },
  }).then(r => r.json());
}

// Invalidate from a Server Action or Route Handler
import { revalidateTag } from 'next/cache';

export async function updateProduct(id: string, data: unknown) {
  await db.product.update({ where: { id }, data });
  revalidateTag(`product-${id}`); // revalidate just this product
  revalidateTag('products');       // revalidate all product lists
}

// ── 5. unstable_cache for DB queries ──────────────
import { unstable_cache } from 'next/cache';

const getCachedUser = unstable_cache(
  async (id: string) => prisma.user.findUnique({ where: { id } }),
  ['user'], // cache key prefix
  { tags: ['users'], revalidate: 60 }
);

// ── 6. Parallel data fetching ─────────────────────
// ❌ Sequential — slow
export default async function ProfilePage({ params }: { params: { id: string } }) {
  const user  = await getUser(params.id);   // 100ms
  const posts = await getPosts(params.id);  // 100ms = 200ms total

  return <Profile user={user} posts={posts} />;
}

// ✅ Parallel — fast
export default async function ProfilePage({ params }: { params: { id: string } }) {
  const [user, posts] = await Promise.all([
    getUser(params.id),
    getPosts(params.id),
  ]); // 100ms total

  return <Profile user={user} posts={posts} />;
}

// ── 7. Streaming with Suspense ────────────────────
import { Suspense } from 'react';

export default function DashboardPage() {
  return (
    <div>
      <h1>Dashboard</h1>
      {/* Renders immediately */}
      <QuickStats />
      {/* Streams in when ready */}
      <Suspense fallback={<ChartSkeleton />}>
        <RevenueChart />  {/* async Server Component */}
      </Suspense>
      <Suspense fallback={<TableSkeleton />}>
        <RecentOrders />  {/* async Server Component */}
      </Suspense>
    </div>
  );
}
```
"""

# ══════════════════════════════════════════════
#  NODE.JS / API DESIGN
# ══════════════════════════════════════════════

MESSAGE user "How do I design a good REST API?"
MESSAGE assistant """```
REST API Design — Complete Reference
```

```
Resource naming (nouns, not verbs):
GET    /users           → list users
POST   /users           → create user
GET    /users/:id       → get one user
PATCH  /users/:id       → update user (partial)
PUT    /users/:id       → replace user (full)
DELETE /users/:id       → delete user

Nested resources:
GET    /users/:id/posts        → posts by user
POST   /users/:id/posts        → create post for user
GET    /users/:id/posts/:postId → specific post

Actions (when REST doesn't fit):
POST   /users/:id/activate     → activate account
POST   /orders/:id/cancel      → cancel order
POST   /auth/refresh           → refresh token
```

```ts
// ── Express REST API with proper patterns ─────────
import express, { Request, Response, NextFunction } from 'express';
import { z } from 'zod';

const router = express.Router();

// ── Zod schemas ───────────────────────────────────
const CreateUserSchema = z.object({
  name:  z.string().min(1).max(100),
  email: z.string().email(),
  role:  z.enum(['admin', 'user']).default('user'),
});

const UpdateUserSchema = CreateUserSchema.partial();

const PaginationSchema = z.object({
  page:  z.coerce.number().int().positive().default(1),
  limit: z.coerce.number().int().min(1).max(100).default(20),
  sort:  z.enum(['name', 'createdAt']).default('createdAt'),
  order: z.enum(['asc', 'desc']).default('desc'),
});

// ── Validate middleware ───────────────────────────
function validate<T>(schema: z.ZodSchema<T>, source: 'body' | 'query' | 'params' = 'body') {
  return (req: Request, res: Response, next: NextFunction) => {
    const result = schema.safeParse(req[source]);
    if (!result.success) {
      return res.status(400).json({
        error: 'Validation failed',
        details: result.error.flatten(),
      });
    }
    req[source] = result.data;
    next();
  };
}

// ── GET /users — list with pagination ─────────────
router.get(
  '/users',
  validate(PaginationSchema, 'query'),
  async (req, res, next) => {
    try {
      const { page, limit, sort, order } = req.query as z.infer<typeof PaginationSchema>;
      const skip = (page - 1) * limit;

      const [users, total] = await Promise.all([
        prisma.user.findMany({
          skip,
          take: limit,
          orderBy: { [sort]: order },
          select: { id: true, name: true, email: true, createdAt: true },
        }),
        prisma.user.count(),
      ]);

      res.json({
        data: users,
        pagination: {
          page,
          limit,
          total,
          pages: Math.ceil(total / limit),
          hasNext: page * limit < total,
          hasPrev: page > 1,
        },
      });
    } catch (err) {
      next(err);
    }
  }
);

// ── POST /users ────────────────────────────────────
router.post(
  '/users',
  validate(CreateUserSchema),
  async (req, res, next) => {
    try {
      const user = await prisma.user.create({
        data: req.body,
        select: { id: true, name: true, email: true, createdAt: true },
      });

      res.status(201).json({ data: user }); // 201 Created
    } catch (err: any) {
      if (err.code === 'P2002') { // Prisma unique constraint
        return res.status(409).json({ error: 'Email already exists' }); // 409 Conflict
      }
      next(err);
    }
  }
);

// ── Global error handler ──────────────────────────
app.use((err: Error, req: Request, res: Response, _next: NextFunction) => {
  console.error(err);
  res.status(500).json({
    error: process.env.NODE_ENV === 'production'
      ? 'Internal server error'
      : err.message,
  });
});
```

**HTTP Status codes:**
- `200 OK` — success
- `201 Created` — resource created
- `204 No Content` — success, nothing to return (DELETE)
- `400 Bad Request` — invalid input
- `401 Unauthorized` — not authenticated
- `403 Forbidden` — authenticated but not allowed
- `404 Not Found` — resource doesn't exist
- `409 Conflict` — duplicate resource
- `422 Unprocessable Entity` — valid JSON but business logic failure
- `429 Too Many Requests` — rate limited
- `500 Internal Server Error` — unhandled exception
"""

# ══════════════════════════════════════════════
#  PERFORMANCE
# ══════════════════════════════════════════════

MESSAGE user "How do I improve my website's Core Web Vitals?"
MESSAGE assistant """Core Web Vitals are Google's three key UX metrics. Here's what causes problems and how to fix them:

**LCP (Largest Contentful Paint) — target: < 2.5s**
The time until the largest visible element renders.

```html
<!-- ❌ LCP killer: hero image with no priority hints -->
<img src="hero.jpg" alt="Hero">

<!-- ✅ Fix: preload + fetchpriority -->
<link rel="preload" as="image" href="hero.webp" fetchpriority="high">
<img
  src="hero.webp"
  alt="Hero"
  fetchpriority="high"
  loading="eager"
  width="1200"
  height="600"
>
```

```tsx
// ✅ Next.js: priority prop on above-fold images
import Image from 'next/image';

<Image
  src="/hero.webp"
  alt="Hero"
  width={1200}
  height={600}
  priority  // preloads the image
/>
```

**CLS (Cumulative Layout Shift) — target: < 0.1**
Unexpected layout shifts as the page loads.

```html
<!-- ❌ CLS killer: image with no dimensions -->
<img src="photo.jpg" alt="Photo">

<!-- ✅ Fix: always specify width and height -->
<img src="photo.jpg" alt="Photo" width="800" height="600">
<!-- Browser reserves space before image loads -->

<!-- ❌ CLS killer: web font FOUT/FOIT -->
<link href="https://fonts.googleapis.com/css2?family=Inter" rel="stylesheet">

<!-- ✅ Fix: font-display: swap + preconnect -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<style>
  @font-face {
    font-family: 'Inter';
    src: url('/fonts/inter.woff2') format('woff2');
    font-display: swap; /* show fallback, swap when loaded */
    size-adjust: 100%;  /* match fallback metrics */
  }
</style>
```

```tsx
// ✅ Next.js font optimisation (zero CLS)
import { Inter } from 'next/font/google';
const inter = Inter({ subsets: ['latin'], display: 'swap' });

export default function Layout({ children }) {
  return <html className={inter.className}>{children}</html>;
}
```

**INP (Interaction to Next Paint) — target: < 200ms**
Responsiveness to user interactions.

```tsx
// ❌ INP killer: heavy computation on click
function handleClick() {
  const result = heavyComputation(largeDataset); // blocks main thread
  setResult(result);
}

// ✅ Fix 1: useTransition — defer non-urgent state update
const [isPending, startTransition] = useTransition();

function handleClick() {
  startTransition(() => {
    setResult(heavyComputation(largeDataset));
  });
}

// ✅ Fix 2: Web Worker for truly heavy work
const worker = new Worker(new URL('./compute.worker.ts', import.meta.url));

function handleClick() {
  worker.postMessage({ data: largeDataset });
  worker.onmessage = (e) => setResult(e.data);
}

// ✅ Fix 3: debounce expensive event handlers
import { useMemo } from 'react';
import debounce from 'lodash.debounce';

const handleSearch = useMemo(
  () => debounce((query: string) => search(query), 300),
  []
);
```

**Bundle size (affects LCP + FID):**

```ts
// ✅ Dynamic imports — load heavy libraries only when needed
const { Chart } = await import('chart.js');

// ✅ Next.js dynamic import with loading state
import dynamic from 'next/dynamic';
const RichEditor = dynamic(() => import('./RichEditor'), {
  loading: () => <EditorSkeleton />,
  ssr: false, // client-only
});

// ✅ Analyse your bundle
// next.config.ts
import { withBundleAnalyzer } from '@next/bundle-analyzer';
export default withBundleAnalyzer({ enabled: process.env.ANALYZE === 'true' })({});
// Run: ANALYZE=true next build
```
"""

