MESSAGE user "What are the most important web security vulnerabilities and how do I prevent them?"
MESSAGE assistant """The OWASP Top 10 for web developers — with practical code:

**1. XSS (Cross-Site Scripting)**
```tsx
// ❌ Never inject user content as raw HTML
<div dangerouslySetInnerHTML={{ __html: userInput }} />

// ✅ React escapes by default — just use JSX
<div>{userInput}</div>

// ✅ If you must render HTML, sanitise first
import DOMPurify from 'dompurify';
<div dangerouslySetInnerHTML={{ __html: DOMPurify.sanitize(userHtml) }} />

// ✅ Content Security Policy header
// next.config.ts
const cspHeader = `
  default-src 'self';
  script-src 'self' 'nonce-${nonce}';
  style-src 'self' 'unsafe-inline';
  img-src 'self' data: https:;
  connect-src 'self' https://api.example.com;
`.trim().replace(/\n/g, ' ');
```

**2. SQL Injection**
```ts
// ❌ Never build SQL with string concatenation
const users = await db.query(`SELECT * FROM users WHERE email = '${email}'`);

// ✅ Use parameterised queries always
const users = await db.query('SELECT * FROM users WHERE email = $1', [email]);

// ✅ Or use an ORM (Prisma, Drizzle) — parameterised by default
const user = await prisma.user.findUnique({ where: { email } });
```

**3. Authentication flaws**
```ts
// ✅ Hash passwords with bcrypt — never store plaintext
import { hash, compare } from 'bcryptjs';

const SALT_ROUNDS = 12; // adjust based on server speed

async function createUser(email: string, password: string) {
  const passwordHash = await hash(password, SALT_ROUNDS);
  return prisma.user.create({ data: { email, passwordHash } });
}

async function verifyPassword(password: string, hash: string) {
  return compare(password, hash); // timing-safe comparison
}

// ✅ JWT — short expiry + refresh token rotation
import { SignJWT, jwtVerify } from 'jose';

const ACCESS_TOKEN_EXPIRY = '15m';  // short-lived
const REFRESH_TOKEN_EXPIRY = '7d';  // longer, stored in httpOnly cookie

async function createTokens(userId: string) {
  const secret = new TextEncoder().encode(process.env.JWT_SECRET);

  const accessToken = await new SignJWT({ sub: userId })
    .setProtectedHeader({ alg: 'HS256' })
    .setExpirationTime(ACCESS_TOKEN_EXPIRY)
    .sign(secret);

  const refreshToken = crypto.randomUUID(); // opaque token
  await storeRefreshToken(userId, refreshToken); // store hash in DB

  return { accessToken, refreshToken };
}
```

**4. CSRF Protection**
```ts
// ✅ SameSite cookies prevent most CSRF
// Set-Cookie: session=...; HttpOnly; Secure; SameSite=Strict

// ✅ For forms that need extra protection — CSRF token
import { randomBytes } from 'crypto';

// Generate per-session token
const csrfToken = randomBytes(32).toString('hex');

// Verify on form submission
function verifyCsrf(req: Request): boolean {
  const cookieToken = getCookieValue(req, 'csrf');
  const headerToken = req.headers.get('x-csrf-token');
  return cookieToken === headerToken; // must match
}
```

**5. Rate Limiting**
```ts
// ✅ Rate limit sensitive endpoints
import { Ratelimit } from '@upstash/ratelimit';
import { Redis } from '@upstash/redis';

const ratelimit = new Ratelimit({
  redis: Redis.fromEnv(),
  limiter: Ratelimit.slidingWindow(10, '1 m'), // 10 requests per minute
});

// Next.js Route Handler
export async function POST(req: Request) {
  const ip = req.headers.get('x-forwarded-for') ?? 'unknown';
  const { success, remaining } = await ratelimit.limit(ip);

  if (!success) {
    return new Response('Too Many Requests', {
      status: 429,
      headers: { 'Retry-After': '60' },
    });
  }

  // ... handle request
}
```

**6. Security headers**
```ts
// next.config.ts — add to all responses
const headers = [
  { key: 'X-Frame-Options',          value: 'DENY' },
  { key: 'X-Content-Type-Options',   value: 'nosniff' },
  { key: 'Referrer-Policy',          value: 'strict-origin-when-cross-origin' },
  { key: 'Permissions-Policy',       value: 'camera=(), microphone=(), geolocation=()' },
  { key: 'Strict-Transport-Security', value: 'max-age=63072000; includeSubDomains; preload' },
];
```
"""

